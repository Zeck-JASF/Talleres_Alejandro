Algoritmo Area_Triangulo
	Definir Base, Altura, Area Como Real
	Escribir "Digite la base, no se admiten letras ni numeros negativos"
	leer Base
	Escribir "Digite la altura, no se admiten letras ni numeros negativos"
	Leer Altura
	Area = Base * Altura / 2
	Escribir "La base que usted digito fue: ", Base 
	Escribir "La altura que usted digito fue: ", Altura 
	Escribir "El área del triangulo es: ", Area 
FinAlgoritmo
