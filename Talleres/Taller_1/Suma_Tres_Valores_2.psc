Algoritmo Suma_Tres_Valores 
	Definir N1,N2,N3,suma como real
	Escribir "Digite el primer valor"
	leer N1
	Escribir "Digite el segundo valor"
	Leer N2
	Escribir "Digite el tercer valor"
	Leer N3
	suma= N1+N2+N3
	Escribir "Los valores que ingresaste son: " N1 " " N2 " y " N3
	Escribir "El resultado de la suma es ", suma
	FinAlgoritmo
