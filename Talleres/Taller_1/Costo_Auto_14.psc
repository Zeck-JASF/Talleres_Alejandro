Algoritmo Costo_Auto
	Definir precio, ganancia, impuesto, total como real 
	precio = 35000000
	ganancia = precio * 0.12
	impuesto = precio * 0.06
	total = precio + ganancia + impuesto
	Escribir "Precio base del vehiculo: ", precio 
	Escribir "Ganancia del vendedor 12%: ", ganancia
	Escribir "Impuesto 6%: ", impuesto 
	Escribir "Costo total para el computador: ", total
FinAlgoritmo
