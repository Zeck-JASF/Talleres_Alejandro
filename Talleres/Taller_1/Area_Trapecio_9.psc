Algoritmo Area_Trapecio
	Definir bMen, bMay, h, Trap como real
	Escribir "Digite la base menor, la base mayor y luego la altura"
	Leer bMen, bMay, h
	Trap = bMen + bMay / 2 * h
	Escribir "La base menor es: ", bMen 
	Escribir "La base mayor es: ", bMay
	Escribir "La altura es: ", h
	Escribir "El area del trapecio es:" , Trap
FinAlgoritmo
