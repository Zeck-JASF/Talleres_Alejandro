Algoritmo Conversor_Metros
	Definir Metros, Km, Hm, Dam, Dm, Cm, Mm Como Real
	Escribir  "Digite la cantidad en metros:"
	Leer Metros
	Km = Metros / 1000
	Hm = Metros / 100
	Dam = Metros / 10
	Dm = Metros * 10
	Cm = Metros  * 100
	Mm = Metros * 1000
	Escribir " Valor ingresado en metros: ", Metros
	Escribir "Kilometros: ", Km
	Escribir "Hectometros: ", Hm
	Escribir "Decametros: ", Dam
	Escribir "Decimetros: ", Dm 
	Escribir "Centimetros: ", Cm
	Escribir "Milimetros: ", Mm
FinAlgoritmo
